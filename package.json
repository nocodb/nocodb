    "*.{ts,tsx,js,json}": []
  },
  "scripts": {
    "bootstrap": "pnpm --filter=nocodb-sdk install && pnpm --filter=nocodb-sdk run build && pnpm --filter=nocodb --filter=nc-mail-templates --filter=nc-gui install && pnpm run integrations:build && pnpm run registerIntegrations",
