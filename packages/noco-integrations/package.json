{
  "name": "nocodb-integrations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-optimized.js",
    "build:all": "pnpm -r build",
    "build:force": "node scripts/build-optimized.js --force",
    "build:verbose": "node scripts/build-optimized.js --verbose",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:watch": "pnpm -r test:watch",
    "lint": "eslint \"packages/**/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"packages/**/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/**/src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/**/src/**/*.{ts,tsx,json,md}\"",
    "fix": "pnpm format && pnpm lint:fix",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^20.17.46",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.5.3",
    "taze": "^19.1.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "tough-cookie@<4.1.3": ">=4.1.3",
      "happy-dom@<15.10.2": ">=15.10.2",
      "esbuild@<=0.24.2": ">=0.25.0",
      "axios@>=1.0.0 <1.16.0": ">=1.16.0",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "postcss@<8.5.10": ">=8.5.10",
      "@modelcontextprotocol/sdk@<1.26.0": ">=1.26.0",
      "defu@<=6.1.4": ">=6.1.5",
      "flatted@<=3.4.1": ">=3.4.2",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "jws@<3.2.3": ">=3.2.3",
      "lodash": ">=4.18.0",
      "lodash-es@<4.18.0": ">=4.18.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "nodemailer@<7.0.11": ">=7.0.11",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "qs@<6.14.1": ">=6.14.1",
      "qs@<=6.15.1": ">=6.15.2",
      "ws@<8.20.1": ">=8.20.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
