      "ip-address@<=10.3.0": ">=10.3.1",
      "@modelcontextprotocol/sdk@<1.31.0": "^1.32.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "defu@<=6.1.4": ">=6.1.5",
      "flatted@<=3.4.1": ">=3.4.2",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.3.0": "~4.3.0",
      "jws@<3.2.3": ">=3.2.3",
