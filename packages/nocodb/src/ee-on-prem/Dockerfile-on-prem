###########
# Builder
###########
FROM node:22.12.0-alpine as builder
WORKDIR /usr/src/app

# install node-gyp dependencies
RUN apk add --no-cache python3 make g++ py3-setuptools

# install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy application dependency manifests to the container image.
COPY ./package.json ./package.json
COPY ./docker/nc-gui/ ./docker/nc-gui/
COPY ./docker/main.js ./docker/index.js
COPY ./docker/configure.sh /usr/src/appEntry/configure.sh
# COPY ./docker/start.sh /usr/src/appEntry/start.sh
COPY ./docker/start-cloud.sh /usr/src/appEntry/start.sh
COPY ./src/public/ ./docker/public/

# for pnpm to generate a flat node_modules without symlinks
# so that modclean could work as expected
RUN echo "node-linker=hoisted" > .npmrc

# Remove workspace/link deps and already-bundled packages (avoids native
# builds for transitive deps like lz4 that crash under QEMU arm64 emulation)
RUN node -e "\
  const p=require('./package.json'); \
  for (const [k,v] of Object.entries(p.dependencies||{})) { \
    if (String(v).startsWith('link:') || String(v).startsWith('workspace:')) delete p.dependencies[k]; \
  } \
  delete p.dependencies['nocodb-sdk']; \
  delete p.dependencies['knex-snowflake']; \
  delete p.dependencies['knex-databricks']; \
  require('fs').writeFileSync('./package.json', JSON.stringify(p, null, 2)); \
"

# Install production dependencies.
# Use --ignore-scripts to prevent native module compilation that crashes
# under QEMU arm64 emulation, then selectively rebuild only what we need.
RUN pnpm install --prod --shamefully-hoist --ignore-scripts

# Rebuild sqlite3 native binary for the target platform
RUN cd node_modules/sqlite3 \
    && npx --yes node-pre-gyp install --fallback-to-build

# Clean up node_modules
RUN pnpm dlx modclean --patterns="default:*" --ignore="libxmljs/**,dayjs/**,express-status-monitor/**,@azure/msal-node/dist/**,@react-email/**,@linear/**,jsdom/**,formdata-polyfill/**,**/lru-cache/**,**/@asamuzakjp/**,**/cssstyle/**" --run \
    && rm -rf ./node_modules/sqlite3/deps

RUN chmod +x /usr/src/appEntry/start.sh


##########
# Runner
##########
FROM node:22.12.0-alpine
WORKDIR /usr/src/app

ENV NC_DOCKER 0.6
ENV NODE_ENV production
ENV PORT 8080
ENV NC_TOOL_DIR=/usr/app/data/

RUN apk --update --no-cache add \
    dumb-init \
    curl \
    jq

# Copy packaged production code & main entry file
COPY --from=builder /usr/src/app/ /usr/src/app/
COPY --from=builder /usr/src/appEntry/ /usr/src/appEntry/

EXPOSE 8080
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start Nocodb
CMD ["/usr/src/appEntry/start.sh"]
