###########
# Builder — runs on the build host (no QEMU), installs all JS deps
###########
FROM --platform=$BUILDPLATFORM node:22.12.0-alpine AS builder
WORKDIR /usr/src/app

# install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy package.json and install production deps (pure-JS only, no native builds)
COPY ./package.json ./package.json

# for pnpm to generate a flat node_modules without symlinks
RUN echo "node-linker=hoisted" > .npmrc

# Remove workspace/link deps and already-bundled packages
RUN node -e "\
  const p=require('./package.json'); \
  for (const [k,v] of Object.entries(p.dependencies||{})) { \
    if (String(v).startsWith('link:') || String(v).startsWith('workspace:')) delete p.dependencies[k]; \
  } \
  delete p.dependencies['nocodb-sdk']; \
  delete p.dependencies['knex-snowflake']; \
  delete p.dependencies['knex-databricks']; \
  require('fs').writeFileSync('./package.json', JSON.stringify(p, null, 2)); \
"

RUN pnpm install --prod --shamefully-hoist --ignore-scripts \
    && pnpm dlx modclean --patterns="default:*" --ignore="libxmljs/**,dayjs/**,express-status-monitor/**,@azure/msal-node/dist/**,@react-email/**,@linear/**,jsdom/**,formdata-polyfill/**,**/lru-cache/**,**/@asamuzakjp/**,**/cssstyle/**" --run

# Copy application files
COPY ./docker/nc-gui/ ./docker/nc-gui/
COPY ./docker/main.js ./docker/index.js
COPY ./docker/configure.sh /usr/src/appEntry/configure.sh
COPY ./docker/start-cloud.sh /usr/src/appEntry/start.sh
COPY ./src/public/ ./docker/public/

RUN chmod +x /usr/src/appEntry/start.sh


###########
# Bin builder — runs on the TARGET platform (QEMU for arm64), builds only
# the native modules that need platform-specific binaries
###########
FROM --platform=$TARGETPLATFORM node:22.12.0-alpine AS bin-builder
WORKDIR /usr/src/app

RUN apk add --no-cache python3 make g++ py3-setuptools

# Extract sqlite3 and sharp versions from the builder's package.json
COPY ./package.json /tmp/pkg.json
RUN SQLITE3_VERSION=$(node -e "console.log(require('/tmp/pkg.json').dependencies['sqlite3'] || '5.1.7')") \
    && SHARP_VERSION=$(node -e "console.log(require('/tmp/pkg.json').dependencies['sharp'] || '0.34.5')") \
    && npm install "sqlite3@${SQLITE3_VERSION}" "sharp@${SHARP_VERSION}" --production


##########
# Runner
##########
FROM --platform=$TARGETPLATFORM node:22.12.0-alpine
WORKDIR /usr/src/app

ENV NC_DOCKER=0.6
ENV NODE_ENV=production
ENV PORT=8080
ENV NC_TOOL_DIR=/usr/app/data/

RUN apk --update --no-cache add \
    dumb-init \
    curl \
    jq

# Copy JS deps and app files from builder (platform-independent)
COPY --from=builder /usr/src/app/ /usr/src/app/
COPY --from=builder /usr/src/appEntry/ /usr/src/appEntry/

# Overlay target-platform native modules from bin-builder
COPY --from=bin-builder /usr/src/app/node_modules/sqlite3/ /usr/src/app/node_modules/sqlite3/
COPY --from=bin-builder /usr/src/app/node_modules/sharp/ /usr/src/app/node_modules/sharp/
COPY --from=bin-builder /usr/src/app/node_modules/@img/ /usr/src/app/node_modules/@img/

# Clean up sqlite3 build artifacts
RUN rm -rf ./node_modules/sqlite3/deps

EXPOSE 8080
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start Nocodb
CMD ["/usr/src/appEntry/start.sh"]
