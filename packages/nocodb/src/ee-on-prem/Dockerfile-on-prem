###########
# Platform-specific runner images
# node:24.14.0-alpine doesn't publish arm/v7 — fall back to node:22-alpine
###########
FROM node:24.14.0-alpine AS runner-amd64
FROM node:24.14.0-alpine AS runner-arm64
FROM node:22-alpine AS runner-arm

###########
# Builder — always runs natively on the build host (no QEMU)
# Uses the host platform's node image for speed, then cross-downloads
# prebuilt native binaries for the target platform
###########
FROM --platform=$BUILDPLATFORM node:24.14.0-alpine AS builder
ARG TARGETPLATFORM

WORKDIR /usr/src/app

# install build tools for native modules
RUN apk add --no-cache python3 make g++ py3-setuptools

# install pnpm
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Copy package.json and install production deps
COPY ./package.json ./package.json
COPY ./pnpm-workspace.yaml ./pnpm-workspace.yaml

# for pnpm to generate a flat node_modules without symlinks
RUN echo "node-linker=hoisted" > .npmrc

# Remove workspace/link deps and already-bundled packages
RUN node -e "\
  const p=require('./package.json'); \
  for (const [k,v] of Object.entries(p.dependencies||{})) { \
    if (String(v).startsWith('link:') || String(v).startsWith('workspace:')) delete p.dependencies[k]; \
  } \
  delete p.dependencies['nocodb-sdk']; \
  delete p.dependencies['knex-snowflake']; \
  delete p.dependencies['knex-databricks']; \
  require('fs').writeFileSync('./package.json', JSON.stringify(p, null, 2)); \
"

RUN pnpm install --prod --shamefully-hoist --ignore-scripts \
    && pnpm dlx modclean --patterns="default:*" --ignore="libxmljs/**,dayjs/**,express-status-monitor/**,@azure/msal-node/dist/**,@react-email/**,@linear/**,jsdom/**,formdata-polyfill/**,**/lru-cache/**,**/@asamuzakjp/**,**/cssstyle/**" --run

# Download prebuilt sqlite3 NAPI binary for the TARGET platform (no QEMU needed).
# sqlite3 v5.x uses prebuild-install with NAPI prebuilds hosted on GitHub releases.
# Prebuilds may not exist for all arch/libc combos (e.g. arm/musl) — allow failure
# since sqlite3 is optional (production uses PostgreSQL).
RUN TARGET_ARCH=$(echo $TARGETPLATFORM | cut -d'/' -f2 | sed 's/amd64/x64/' | sed 's/arm64/arm64/') \
    && cd node_modules/sqlite3 \
    && npx --yes prebuild-install -r napi --platform linux --arch ${TARGET_ARCH} --libc musl 2>/dev/null; \
    rm -rf node_modules/sqlite3/deps 2>/dev/null; true

# Install sharp for the target platform (sharp uses npm optional deps for prebuilds)
RUN TARGET_ARCH=$(echo $TARGETPLATFORM | cut -d'/' -f2 | sed 's/amd64/x64/' | sed 's/arm64/arm64/') \
    && npm install --no-save --os=linux --cpu=${TARGET_ARCH} sharp 2>/dev/null; true

# Copy application files
COPY ./docker/nc-gui/ ./docker/nc-gui/
COPY ./docker/main.js ./docker/index.js
COPY ./docker/*.main.js ./docker/
COPY ./docker/configure.sh /usr/src/appEntry/configure.sh
COPY ./docker/start-cloud.sh /usr/src/appEntry/start.sh
COPY ./src/public/ ./docker/public/

RUN chmod +x /usr/src/appEntry/start.sh


##########
# Runner — uses platform-specific image for the target arch
##########
ARG TARGETARCH
FROM runner-${TARGETARCH}
WORKDIR /usr/src/app

ENV NC_DOCKER=0.6
ENV NODE_ENV=production
ENV PORT=8080
ENV NC_TOOL_DIR=/usr/app/data/

RUN apk --update --no-cache add \
    dumb-init \
    curl \
    jq

# Copy packaged production code & main entry file
COPY --from=builder /usr/src/app/ /usr/src/app/
COPY --from=builder /usr/src/appEntry/ /usr/src/appEntry/

EXPOSE 8080
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start Nocodb
CMD ["/usr/src/appEntry/start.sh"]
