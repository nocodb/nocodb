{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "rootDir": "../../src",
    "baseUrl": "../../",
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "~/*": [
        "./src/ee-on-prem/*",
        "./src/ee/*",
        "./src/*"
      ],
      "@/*": [
        "./src/ee-on-prem/*",
        "./src/ee/*",
        "./src/*"
      ],
      "@noco-local-integrations/*": [
        "../noco-integrations/packages/*"
      ],
      "@noco-local-integrations/core": [
        "../noco-integrations/core"
      ]
    }
  },
  "include": ["../../src/**/*"],
  "exclude": ["../../src/ee-cloud", "../../src/**/*.spec.ts", "../../src/ee/daos/**"]
}
