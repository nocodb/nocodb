{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "src/*": ["src/*"],
      "~/*": ["src/ee-cloud/*", "src/ee-on-prem/*", "src/ee/*", "src/*"],
      "@/*": ["src/ee-cloud/*", "src/ee-on-prem/*", "src/ee/*", "src/*"],
      "@noco-local-integrations/*": ["../noco-integrations/packages/*"],
      "@noco-local-integrations/core": ["../noco-integrations/core"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.spec.ts"]
}
