{
  "compilerOptions": {
    /* module/moduleResolution are set for type checking only (IDE + tsc --noEmit).
       Actual compilation is handled by SWC via rspack, which ignores these settings.
       "bundler" avoids an infinite peer-dependency resolution loop */
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "lib": ["es2022"],
    "useDefineForClassFields": false,
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictBindCallApply": false,
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react",
    "paths": {
      "src/*": ["./src/*"],
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@noco-local-integrations/*": ["../noco-integrations/packages/*"],
      "@noco-local-integrations/core": ["../noco-integrations/core"]
    },
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src/**/*"],
  /* src/run/cloud.ts is the entry for the ee-cloud and ee-on-prem rspack
     builds only — the CE entry is src/run/docker.ts — so it resolves `~/`
     through the EE overlay and is typechecked by those programs, not this one. */
  "exclude": [
    "src/ee",
    "src/ee-on-prem",
    "src/ee-cloud",
    "src/run/cloud.ts",
    "**/*.spec.ts"
  ]
}
